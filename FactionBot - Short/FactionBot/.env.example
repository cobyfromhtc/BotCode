# FactionBot — Environment Configuration
# Copy this file to .env and fill in your values.

# === REQUIRED ===
# Your Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# === RECOMMENDED (for full slash-command support) ===
# Comma-separated list of guild IDs where premium slash commands
# (TicketTool + ReactionRoles) will be registered. This scopes 56 premium
# commands to your server's per-guild bucket (separate from the 100-command
# global limit), so ALL 133 commands get both prefix (!) and slash (/) support.
#
# Without this: the bot still starts (no crash), but once the global slash
# count hits 100, remaining commands become prefix-only (no /slash).
#
# To find your guild ID: enable Developer Mode in Discord settings, then
# right-click your server name → Copy Server ID.
HOME_GUILD_IDS=123456789012345678

# === OPTIONAL — Multi-bot support ===
# Instead of BOT_TOKEN, you can run separate bots per domain:
# ModBot_Token=YOUR_MODERATION_BOT_TOKEN
# TicketBot_Token=YOUR_TICKET_BOT_TOKEN
# UtilityBot_Token=YOUR_UTILITY_BOT_TOKEN
#
# Or a comma-separated list:
# BOT_TOKENS=modToken,ticketToken,utilityToken
#
# Add custom bots (2 lines each):
# FunBot_Token=YOUR_TOKEN
# FunBot_Cmds=poll,giveaway,endgiveaway
